;
; vhid.inf (from vhidmini2 VhidminiUm.inx, Windows-driver-samples, MS-PL)
; Root nodes, one vhid.dll, one WUDFHost (same DeviceGroupId, spec 0016):
; - Root\MixLinkVHid: UMDF 2 HID minidriver (keyboard / mouse); mshidumdf.sys (inbox) sits above it.
; - Root\MixLinkVHidCtl: plain UMDF function driver; the service feeds reports through its interface.
; - Root\VID_045E&PID_0B13&IG_00: a virtual Xbox pad (software device SWD\MixLinkPad\000N per slot), same
;   install sections as the HID node; its HID child is HID\VID_045E&PID_0B13&IG_00, which the inbox
;   xinputhid.inf binds.
; Needs build 22000+.
;

[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%ManufacturerName%
CatalogFile=vhid.cat
DriverVer=
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
vhid.dll=1

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...22000]
%DeviceName%=VHid_Install, Root\MixLinkVHid
%CtlDeviceName%=VHidCtl_Install, Root\MixLinkVHidCtl
%PadDeviceName%=VHid_Install, Root\VID_045E&PID_0B13&IG_00

; =================== HID node ==================================

[VHid_Install.NT]
CopyFiles=UMDriverCopy
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT

[VHid_Install.NT.hw]
AddReg = VHid_Group_AddReg
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.hw
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.hw

[VHid_Install.NT.Services]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.Services
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Services

[VHid_Install.NT.Filters]
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Filters

[VHid_Install.NT.Wdf]
UmdfService="vhid", VHid_UmdfInstall
UmdfServiceOrder=vhid
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

; =================== Control node ==================================

[VHidCtl_Install.NT]
CopyFiles=UMDriverCopy
Include=WUDFRD.inf
Needs=WUDFRD.NT

[VHidCtl_Install.NT.hw]
AddReg = VHid_Group_AddReg, VHidCtl_Security_AddReg
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW

[VHidCtl_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[VHidCtl_Install.NT.Wdf]
UmdfService="vhid", VHid_UmdfInstall
UmdfServiceOrder=vhid

; =================== Shared ==================================

[VHid_Group_AddReg]
HKR,"WUDF","DeviceGroupId",,"MixLinkVHidGroup" ; both nodes in one WUDFHost (spec 0016)

[VHidCtl_Security_AddReg]
HKR,,"Security",,"D:P(A;;GA;;;SY)(A;;GA;;;BA)" ; SYSTEM and Administrators only (spec 0016)

[VHid_UmdfInstall]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary="%13%\vhid.dll"

[UMDriverCopy]
vhid.dll

[Strings]
ManufacturerName="MixLink"
DiskName="MixLink Virtual Input Installation Disk"
DeviceName="MixLink Virtual Input"
CtlDeviceName="MixLink Virtual Input Control"
PadDeviceName="MixLink Virtual Xbox Controller"
