<Project>
  <!-- WDK + SDK from NuGet (pinned in vdisplay/packages.config); restored into drivers/packages by build.ps1. -->
  <PropertyGroup>
    <MixLinkWdkVersion>10.0.28000.2526</MixLinkWdkVersion>
    <MixLinkPackagesDir>$(MSBuildThisFileDirectory)packages\</MixLinkPackagesDir>
  </PropertyGroup>
  <Import Project="$(MixLinkPackagesDir)Microsoft.Windows.WDK.x64.$(MixLinkWdkVersion)\build\native\Microsoft.Windows.WDK.x64.props" Condition="Exists('$(MixLinkPackagesDir)Microsoft.Windows.WDK.x64.$(MixLinkWdkVersion)\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(MixLinkPackagesDir)Microsoft.Windows.SDK.CPP.x64.$(MixLinkWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props" Condition="Exists('$(MixLinkPackagesDir)Microsoft.Windows.SDK.CPP.x64.$(MixLinkWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(MixLinkPackagesDir)Microsoft.Windows.SDK.CPP.$(MixLinkWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.props" Condition="Exists('$(MixLinkPackagesDir)Microsoft.Windows.SDK.CPP.$(MixLinkWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.props')" />
</Project>
