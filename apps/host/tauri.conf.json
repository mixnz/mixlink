{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixLink Host",
  "identifier": "app.mixlink.host",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "ui" }
  },
  "app": {
    "windows": [
      { "label": "main", "title": "MixLink Host", "width": 480, "height": 360, "visible": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
