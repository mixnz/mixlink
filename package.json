{
  "name": "mixlink",
  "private": true,
  "type": "module",
  "workspaces": ["packages/i18n", "apps/client/ui", "apps/host/ui"],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --test \"packages/i18n/src/**/*.test.ts\"",
    "build": "npm run build --workspace @mixlink/client-ui --workspace @mixlink/host-ui",
    "dev:client": "cd apps/client && tauri dev",
    "dev:host": "cd apps/host && tauri dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
